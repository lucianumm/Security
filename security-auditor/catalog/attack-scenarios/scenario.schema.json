{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Defensive attack path record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "asset", "attacker", "objective", "entryPoint", "boundary", "preconditions", "steps", "controls", "counterevidence", "sink", "impact", "evidence", "validation", "confidence", "status", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "scenarioId": {"type": "string", "pattern": "^AS-[0-9]{2,5}$"},
    "asset": {"type": "string", "minLength": 1, "maxLength": 300},
    "attacker": {"type": "object", "additionalProperties": false, "required": ["actor", "startingCapability", "controlledInputs"], "properties": {"actor": {"type": "string", "minLength": 1, "maxLength": 200}, "startingCapability": {"type": "string", "minLength": 1, "maxLength": 2000}, "controlledInputs": {"type": "array", "items": {"type": "string", "maxLength": 1000}}}},
    "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
    "entryPoint": {"type": "string", "minLength": 1, "maxLength": 1000},
    "boundary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "preconditions": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["action", "evidence", "resultingCapability"], "properties": {"action": {"type": "string", "minLength": 1, "maxLength": 1000}, "evidence": {"type": "array", "items": {"type": "string", "maxLength": 1000}}, "resultingCapability": {"type": "string", "maxLength": 1000}}}},
    "controls": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "counterevidence": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "sink": {"type": "string", "minLength": 1, "maxLength": 1000},
    "impact": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["profile", "method", "authorized", "result"], "properties": {"profile": {"enum": ["offline-static", "advisory-update", "authorized-local-test", "authorized-staging-test", "not-run"]}, "method": {"type": "string", "maxLength": 1000}, "authorized": {"type": "boolean"}, "result": {"type": "string", "maxLength": 1000}}},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "status": {"enum": ["HYPOTHESIS", "SUPPORTED", "REPRODUCED", "REFUTED", "INCONCLUSIVE", "NOT_APPLICABLE"]},
    "limitations": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
  }
}
