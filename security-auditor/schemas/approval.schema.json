{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt recorded only after an explicit user approval in a trusted channel",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "decision", "planDigest", "sourceDigest", "approvedActions", "approvedBy", "userMessageRef", "issuedAt", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": 1}, "decision": {"const": "APPROVED"},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approvedActions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PLAN-[0-9]{4,8}$"}},
    "approvedBy": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "userMessageRef": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}
  }
}
