{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Encyclopedia coverage ledger, separate from the v2 CI state",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceDigest", "catalogDigest", "scope", "complete", "discovery", "controls", "domains", "scenarios"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceDigest": {"$ref": "#/$defs/digest"}, "catalogDigest": {"$ref": "#/$defs/digest"},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "complete": {"type": "boolean"},
    "discovery": {"type": "object"},
    "domains": {"type": "array", "minItems": 19, "maxItems": 19, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "candidate", "modules"],
      "properties": {"id": {"type": "string", "pattern": "^ENC-D[0-9]{2}$"}, "candidate": {"type": "boolean"}, "modules": {"type": "array", "items": {"type": "string"}}}
    }},
    "controls": {"type": "array", "minItems": 136, "maxItems": 136, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "applicability", "evidence", "reason", "findings"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
        "status": {"enum": ["IMPLEMENTED", "PARTIALLY_IMPLEMENTED", "NOT_IMPLEMENTED", "MISCONFIGURED", "NOT_APPLICABLE", "NOT_VERIFIED"]},
        "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE", "UNKNOWN"]},
        "evidence": {"$ref": "#/$defs/evidence"}, "reason": {"type": "string", "maxLength": 4000}, "findings": {"$ref": "#/$defs/findings"}
      }
    }},
    "scenarios": {"type": "array", "minItems": 507, "maxItems": 507, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "evidence", "reason", "findings"],
      "properties": {
        "id": {"type": "string", "pattern": "^ENC-D[0-9]{2}-S[0-9]{3}$"},
        "status": {"enum": ["NOT_VERIFIED", "SUPPORTED", "REPRODUCED", "REFUTED", "INCONCLUSIVE", "NOT_APPLICABLE"]},
        "evidence": {"$ref": "#/$defs/evidence"}, "reason": {"type": "string", "maxLength": 4000}, "findings": {"$ref": "#/$defs/findings"}
      }
    }}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}},
    "findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SEC-[0-9]{4,8}$"}}
  }
}
