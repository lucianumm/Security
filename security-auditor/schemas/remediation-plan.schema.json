{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact local patch batch proposed for user approval",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "projectRoot", "sourceDigest", "catalogDigest", "patchSha256", "actions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projectRoot": {"type": "string", "minLength": 1, "maxLength": 4000},
    "sourceDigest": {"$ref": "#/$defs/digest"}, "catalogDigest": {"$ref": "#/$defs/digest"}, "patchSha256": {"$ref": "#/$defs/digest"},
    "actions": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation", "findingIds", "controlIds", "paths", "summary", "risk", "regressionTests", "rollback"],
      "properties": {
        "id": {"type": "string", "pattern": "^PLAN-[0-9]{4,8}$"},
        "operation": {"const": "PATCH_LOCAL"},
        "findingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SEC-[0-9]{4,8}$"}},
        "controlIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"}},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "summary": {"$ref": "#/$defs/text"}, "risk": {"$ref": "#/$defs/text"}, "rollback": {"$ref": "#/$defs/text"},
        "regressionTests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    }}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S"}
  }
}
