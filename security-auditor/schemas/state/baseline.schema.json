{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucianumm/Security/blob/main/security-auditor/schemas/state/baseline.schema.json",
  "title": "Security Auditor trusted baseline and gate policy",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "project", "scope", "controls", "blockingPolicy"],
  "properties": {
    "schemaVersion": {"const": 2},
    "project": {"type": "string", "minLength": 1, "maxLength": 200},
    "scope": {"type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": {"included": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "excluded": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "controls": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "expected"], "properties": {"id": {"type": "string", "pattern": "^[a-zA-Z0-9._:-]{1,128}$"}, "expected": {"enum": ["IMPLEMENTED", "PARTIALLY_IMPLEMENTED", "NOT_IMPLEMENTED", "MISCONFIGURED", "NOT_APPLICABLE", "NOT_VERIFIED"]}}}},
    "blockingPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["failPipelineOn", "blockProductionOnHigh", "blockOnIncomplete", "allowMitigated", "minimumCoverage", "maxFindingAgeDays", "requiredTools"],
      "properties": {
        "failPipelineOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]{1,80}$"}},
        "blockProductionOnHigh": {"type": "boolean"},
        "blockOnIncomplete": {"type": "boolean"},
        "requireEncyclopediaCoverage": {"type": "boolean"},
        "allowMitigated": {"type": "boolean"},
        "minimumCoverage": {"type": "number", "minimum": 0.01, "maximum": 1},
        "maxFindingAgeDays": {"type": "integer", "minimum": 1, "maximum": 365},
        "requiredTools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["tool", "successExitCodes"], "properties": {"tool": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "successExitCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 255}}}}}
      }
    }
  }
}
