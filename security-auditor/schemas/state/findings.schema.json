{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucianumm/Security/blob/main/security-auditor/schemas/state/findings.schema.json",
  "title": "Security Auditor findings state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "source", "coverage", "scanners", "controls", "findings"],
  "properties": {
    "schemaVersion": {"const": 2},
    "project": {"type": "string", "minLength": 1, "maxLength": 200},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceDigest", "policyDigest", "scope", "generatedAt", "complete"],
      "properties": {
        "sourceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policyDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "generatedAt": {"type": "string", "format": "date-time"},
        "complete": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["applicableControls", "verifiedControls"],
      "properties": {
        "applicableControls": {"type": "integer", "minimum": 1},
        "verifiedControls": {"type": "integer", "minimum": 0}
      }
    },
    "scanners": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["tool", "version", "ran", "exitCode"],
        "properties": {
          "tool": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 100},
          "ran": {"type": "boolean"},
          "exitCode": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
        }
      }
    },
    "controls": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9._:-]{1,128}$"},
          "status": {"enum": ["IMPLEMENTED", "PARTIALLY_IMPLEMENTED", "NOT_IMPLEMENTED", "MISCONFIGURED", "NOT_APPLICABLE", "NOT_VERIFIED"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
        }
      }
    },
    "findings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "severity", "priority", "confidence", "status", "layer", "category", "affected", "evidence", "impact", "fixType", "regressionTest", "verification", "firstSeen", "lastSeen", "fixedIn", "history"],
      "properties": {
        "id": {"type": "string", "pattern": "^SEC-[0-9]{4,8}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "status": {"enum": ["OPEN", "FIXED", "PARTIALLY_FIXED", "MITIGATED", "ACCEPTED_RISK", "EXTERNAL_ACTION_REQUIRED", "NOT_VERIFIED", "REGRESSION"]},
        "layer": {"enum": ["APPLICATION_CODE", "FRONTEND", "BACKEND", "DATABASE", "INFRASTRUCTURE", "CLOUD", "CONTAINER", "CI_CD", "SUPPLY_CHAIN", "OPERATIONAL", "HUMAN_ACTION"]},
        "category": {"type": "string", "minLength": 1, "maxLength": 120},
        "cwe": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}},
        "owasp": {"type": "array", "items": {"type": "string", "maxLength": 100}},
        "asvs": {"type": "string", "maxLength": 100},
        "affected": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 12000},
        "impact": {"type": "string", "minLength": 1, "maxLength": 4000},
        "fixType": {"enum": ["SAFE_AUTO_FIX", "REVIEW_RECOMMENDED", "MANUAL_INFRASTRUCTURE_ACTION", "SECRET_ROTATION_REQUIRED", "ARCHITECTURAL_CHANGE", "MANUAL_ACTION"]},
        "regressionTest": {"type": ["string", "null"], "maxLength": 1000},
        "verification": {"type": ["object", "null"], "additionalProperties": false, "required": ["verifiedAt", "method", "evidence"], "properties": {"verifiedAt": {"type": "string", "format": "date-time"}, "method": {"enum": ["regression_test", "manual_check", "scanner"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}}},
        "compensatingControls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "firstSeen": {"type": "string", "format": "date"},
        "lastSeen": {"type": "string", "format": "date"},
        "fixedIn": {"type": ["string", "null"], "maxLength": 100},
        "history": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["date", "status", "note"], "properties": {"date": {"type": "string", "format": "date"}, "status": {"type": "string", "maxLength": 40}, "note": {"type": "string", "maxLength": 1000}}}}
      }
    }
  }
}
